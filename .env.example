# Copy to .env.local and generate a unique secret. Never commit real credentials.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Empty DATABASE_URL uses local-only PGlite. Production requires PostgreSQL.
DATABASE_URL=
DEMO_MODE=true

# Optional, disabled until a verified sender and delivery test are approved.
AUTH_EMAIL_ENABLED=false
AUTH_EMAIL_REQUIRED_FROM=
AUTH_EMAIL_FROM=
RESEND_API_KEY=
